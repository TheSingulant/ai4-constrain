# Copy to .env locally. Never commit secrets.
# Default path is offline mock. No API key is required for pytest.

AI4_PROVIDER=mock
AI4_ENABLE_LIVE_LLM=0

# Paid / live LLM calls are refused unless a hard cap is set first.
# Leave unset or 0 for CI and local offline runs.
AI4_MAX_SPEND_USD=0

# Optional live provider (OpenAI-compatible). Used only when
# AI4_ENABLE_LIVE_LLM=1 and AI4_MAX_SPEND_USD > 0.
# AI4_API_KEY=
# AI4_API_BASE=https://api.openai.com/v1
# AI4_MODEL=gpt-4o-mini

# Optional Solana JSON-RPC for ai4.transaction status / fee hint / DevNet E2E.
# Leave empty to skip RPC. Never commit a live URL with credentials.
# There is no hardcoded public RPC in the library.
# For the DevNet E2E proof you must pass --rpc-url or set this variable.
# Operators may use the public DevNet endpoint (rate-limited; fail closed):
#   https://api.devnet.solana.com
AI4_SOLANA_RPC_URL=
